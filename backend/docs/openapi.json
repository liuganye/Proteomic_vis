        ],
        "summary": "Samples",
        "operationId": "samples_api_v1_qc_samples_get",
        "parameters": [
          {
            "name": "organism",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Organism"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QCResponse"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/structures/{pdb_id}": {
      "get": {
        "tags": [
          "structures"
        ],
        "summary": "Structure",
        "operationId": "structure_api_v1_structures__pdb_id__get",
        "parameters": [
          {
            "name": "pdb_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{4}$",
              "title": "Pdb Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AbundancePoint": {
        "properties": {
          "sample_id": {
            "type": "string",
            "title": "Sample Id"
          },
          "display_group": {
            "type": "string",
            "title": "Display Group"
          },
          "intensity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Intensity"
          },
          "log2_intensity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Log2 Intensity"
          },
          "observed": {
            "type": "boolean",
            "title": "Observed"
          }
        },
        "type": "object",
        "required": [
          "sample_id",
          "display_group",
          "intensity",
          "log2_intensity",
          "observed"
        ],
        "title": "AbundancePoint"
      },
      "AbundanceResponse": {
        "properties": {
          "protein_id": {
            "type": "string",
            "title": "Protein Id"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/AbundancePoint"
            },
            "type": "array",
            "title": "Points"
          },
          "missing_policy": {
            "type": "string",
            "title": "Missing Policy",
            "default": "zero or blank -> null; no imputation in this response"
          }
        },
        "type": "object",
        "required": [
          "protein_id",
          "points"
        ],
        "title": "AbundanceResponse"
      },
      "Contrast": {
        "properties": {
          "contrast_id": {
            "type": "string",
            "title": "Contrast Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "direction": {
            "type": "string",
            "title": "Direction"
          },
          "method": {
            "type": "string",
            "title": "Method"
          },
          "source_file": {
            "type": "string",
            "title": "Source File"
          },
          "evaluated_count": {
            "type": "integer",
            "title": "Evaluated Count"
          },
          "sample_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sample Ids"
          },
          "provenance": {
            "type": "string",
            "title": "Provenance"
          }
        },
        "type": "object",
        "required": [
          "contrast_id",
          "label",
          "direction",
          "method",
          "source_file",
          "evaluated_count",
          "sample_ids",
          "provenance"
        ],
        "title": "Contrast"
      },
      "DatasetSummary": {
        "properties": {
          "schema_version": {
            "type": "string",
            "title": "Schema Version",
            "default": "1.0"
          },
          "protein_count": {
            "type": "integer",
            "title": "Protein Count"
          },
          "sample_count": {
            "type": "integer",
            "title": "Sample Count"
          },
          "differential_result_count": {
            "type": "integer",
            "title": "Differential Result Count"
          },
          "network_edge_count": {
            "type": "integer",
            "title": "Network Edge Count"
          },
          "local_structure_count": {
            "type": "integer",
            "title": "Local Structure Count"
          },
          "organism_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Organism Counts"
          },
          "source_files": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Source Files"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "type": "object",
        "required": [
          "protein_count",
          "sample_count",
          "differential_result_count",
          "network_edge_count",
          "local_structure_count",
          "organism_counts",
          "source_files",
          "warnings"
        ],
        "title": "DatasetSummary"
      },
      "DifferentialPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/DifferentialResult"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "contrast_id": {
            "type": "string",
            "title": "Contrast Id"
          },
          "p_value_mode": {
            "type": "string",
            "enum": [
              "adjusted",
              "raw"
            ],
            "title": "P Value Mode"
          },
          "p_cutoff": {
            "type": "number",
            "title": "P Cutoff"
          },
          "abs_log2_fc_cutoff": {
            "type": "number",
            "title": "Abs Log2 Fc Cutoff"
          },
          "evaluated_count": {
            "type": "integer",
            "title": "Evaluated Count"
          },
          "note": {
            "type": "string",
            "title": "Note",
            "default": "Filtering does not refit the model or recompute BH adjusted p-values."
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "offset",
          "limit",
          "contrast_id",
          "p_value_mode",
          "p_cutoff",
          "abs_log2_fc_cutoff",
          "evaluated_count"
        ],
        "title": "DifferentialPage"
      },
      "DifferentialResult": {
        "properties": {
          "protein_id": {
            "type": "string",
            "title": "Protein Id"
          },
          "gene": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gene"
          },
          "organism": {
            "type": "string",
            "title": "Organism"
          },
          "log2_fc": {
            "type": "number",
            "title": "Log2 Fc"
          },
          "p_value": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "P Value"
          },
          "adj_p": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Adj P"
          },
          "significant": {
            "type": "boolean",
            "title": "Significant"
          }
        },
        "type": "object",
        "required": [
          "protein_id",
          "gene",
          "organism",
          "log2_fc",
          "p_value",
          "adj_p",
          "significant"
        ],
        "title": "DifferentialResult"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Neighborhood": {
        "properties": {
          "protein_id": {
            "type": "string",
            "title": "Protein Id"
          },
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/Protein"
            },
            "type": "array",
            "title": "Nodes"
          },
          "edges": {
            "items": {
              "$ref": "#/components/schemas/NetworkEdge"
            },
            "type": "array",
            "title": "Edges"
          },
          "total_neighbors": {
            "type": "integer",
            "title": "Total Neighbors"
          },
          "truncated": {
            "type": "boolean",
            "title": "Truncated"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "default": "STRING chunked network export; incomplete functional association graph"
          },
          "note": {
            "type": "string",
            "title": "Note",
            "default": "Score is confidence, not binding strength. No model fitting is performed."
          }
        },
        "type": "object",
        "required": [
          "protein_id",
          "nodes",
          "edges",
          "total_neighbors",
          "truncated"
        ],
        "title": "Neighborhood"
      },
      "NetworkEdge": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source"
          },
          "target": {
            "type": "string",
            "title": "Target"
          },
          "score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score"
          },
          "species": {
            "type": "integer",
            "title": "Species"
          },
          "evidence": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Evidence"
          }
        },
        "type": "object",
        "required": [
          "source",
          "target",
          "score",
          "species",
          "evidence"
        ],
        "title": "NetworkEdge"
