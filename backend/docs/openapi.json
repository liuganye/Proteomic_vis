    "/api/v1/contrasts/{contrast_id}/results": {
      "get": {
        "tags": [
          "contrasts"
        ],
        "summary": "Results",
        "operationId": "results_api_v1_contrasts__contrast_id__results_get",
        "parameters": [
          {
            "name": "contrast_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Contrast Id"
            }
          },
          {
            "name": "organism",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Organism"
            }
          },
          {
            "name": "p_value_mode",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "adjusted",
                "raw"
              ],
              "type": "string",
              "default": "adjusted",
              "title": "P Value Mode"
            }
          },
          {
            "name": "p_cutoff",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 1,
              "exclusiveMinimum": 0,
              "default": 0.05,
              "title": "P Cutoff"
            }
          },
          {
            "name": "abs_log2_fc_cutoff",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": 0,
              "default": 0.7,
              "title": "Abs Log2 Fc Cutoff"
            }
          },
          {
            "name": "significant_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Significant Only"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10000,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DifferentialPage"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/networks/{protein_id}/neighbors": {
      "get": {
