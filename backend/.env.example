# Optional: data root with raw/, processed/, external/pdb_files/, or a flat dataset directory.
# PROTEIN_DATA_DIR=C:/path/to/data
PROTEIN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:43147,http://127.0.0.1:43147
# Optional: download structures from PDBe/RCSB/AlphaFold when none is bundled (default 1).
# PROTEIN_STRUCTURE_ONLINE=0
# Optional: where downloaded structures are cached (default: <repo>/.cache/structures).
# PROTEIN_STRUCTURE_CACHE_DIR=C:/path/to/cache
